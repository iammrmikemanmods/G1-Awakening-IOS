    <key>G1SourceCommit</key><string>@G1_SOURCE_COMMIT@</string>
    <key>G1ArtifactKind</key><string>Native campaign integration test</string>
    <key>G1FeatureScope</key><string>Native tactical gameplay, campaign and checkpoint restore, original support presentation and first-use tutorial, original bitmap headings, profile migration and pause-safe presentation; full rendered playthrough, remaining original output fidelity and physical iPhone XR validation remain outstanding</string>
</dict></plist>
