+
+/// CPU-backend capability queried by the native host before game launch.
+/// Zero means this core requires no JIT; nonzero means JIT is required.
+/// This reports a build capability and never claims the OS granted JIT.
+#[no_mangle]
+pub extern "C" fn touchhle_ios_requires_jit() -> u32 {
+    if cfg!(feature = "cpu-interpreter") { 0 } else { 1 }
