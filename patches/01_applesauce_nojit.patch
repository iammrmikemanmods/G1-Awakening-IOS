+//! Adapter preserving Applesauce's CPU boundary for the no-JIT interpreter.
+use crate::abi::GuestFunction;
+use crate::mem::{GuestUSize, Mem};
+use super::interpreter::InterpreterCpu;
+pub use super::interpreter::CpuContext;
+
+#[derive(Debug)]
+pub enum CpuState {
+    Normal,
+    Svc(u32),
+    Error(CpuError),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum CpuError {
+    MemoryError,
+    UndefinedInstruction,
+    Breakpoint,
+}
+
+pub struct Cpu {
+    core: Box<InterpreterCpu>,
+}
+
+impl Cpu {
+    pub const SP: usize = 13;
+    pub const LR: usize = 14;
+    pub const PC: usize = 15;
+    pub const CPSR_THUMB: u32 = 0x20;
+    pub const CPSR_USER_MODE: u32 = 0x10;
+
+    pub fn new(direct_memory_access: Option<&mut Mem>) -> Self {
+        let pages = direct_memory_access
+            .map_or(0, |mem| mem.null_segment_size() / 0x1000);
+        echo!("CPU backend: ARM interpreter (no JIT)");
+        Self { core: InterpreterCpu::new(pages) }
+    }
+
+    pub fn regs(&self) -> &[u32; 16] { self.core.regs() }
+    pub fn regs_mut(&mut self) -> &mut [u32; 16] { self.core.regs_mut() }
+    pub fn cpsr(&self) -> u32 { self.core.cpsr() }
+    pub fn set_cpsr(&mut self, value: u32) { self.core.set_cpsr(value); }
+    pub fn swap_context(&mut self, context: &mut CpuContext) {
+        self.core.swap_context(context);
+    }
+
+    pub fn pc_with_thumb_bit(&self) -> GuestFunction {
+        GuestFunction::from_addr_and_thumb_flag(
+            self.regs()[Self::PC], self.cpsr() & Self::CPSR_THUMB != 0)
+    }
+
+    pub fn branch(&mut self, pc: GuestFunction) {
+        self.regs_mut()[Self::PC] = pc.addr_without_thumb_bit();
+        let mode = if pc.is_thumb() { Self::CPSR_THUMB } else { 0 };
+        self.set_cpsr((self.cpsr() & !Self::CPSR_THUMB) | mode);
+    }
+
+    pub fn branch_with_link(
+        &mut self, pc: GuestFunction, lr: GuestFunction,
+    ) -> (GuestFunction, GuestFunction) {
+        let old_pc = self.pc_with_thumb_bit();
+        let old_lr = GuestFunction::from_addr_with_thumb_bit(self.regs()[Self::LR]);
+        self.branch(pc);
+        self.regs_mut()[Self::LR] = lr.addr_with_thumb_bit();
+        (old_pc, old_lr)
+    }
+
+    pub fn invalidate_cache_range(&mut self, base: u32, size: GuestUSize) {
+        // The interpreter fetches every instruction from current guest bytes.
+        self.core.invalidate_cache_range(base, size);
+    }
+
+    #[must_use]
+    pub fn run_or_step(&mut self, mem: &mut Mem, ticks: Option<&mut u64>) -> CpuState {
+        self.core.run_or_step(mem, ticks)
+    }
+
+    pub fn dump_regs(&self) { Self::echo_regs(self.regs()); }
+    pub fn echo_regs(regs: &[u32; 16]) {
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            for row in 0..4 {
+                let first = row * 4;
+                echo!("R{:02}={:#010x} R{:02}={:#010x} R{:02}={:#010x} R{:02}={:#010x}",
+                    first, regs[first], first + 1, regs[first + 1],
+                    first + 2, regs[first + 2], first + 3, regs[first + 3]);
+            }
+        }));
+    }
+}
