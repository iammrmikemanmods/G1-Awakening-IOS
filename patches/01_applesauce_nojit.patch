+                assert!(matches!(cpu.run_or_step(&mut mem, None), CpuState::Normal));
+                for (index, value) in cpu.core.extregs().iter().enumerate() {
+                    assert_eq!(*value, if index == sn as usize { 0x89abcdef } else { 0x11223344 },
