+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Optional, fixed guest windows for the interpreter. Guest addresses do not
+//! change, and host allocations never move during the lifetime of Mem.
+
+use super::{host, GuestUSize, Mem, VAddr, PAGE_SIZE_ALIGN_MASK};
+
+pub(super) const LOW_SIZE: GuestUSize = 0x4000_0000;
+
+struct Window {
+    guest_base: VAddr,
+    size: usize,
+    host_base: *mut u8,
+}
+
+impl Window {
+    fn new(guest_base: VAddr, size: usize) -> std::io::Result<Self> {
+        let host_base = unsafe { host::allocate_guest_memory(size)? }.cast::<u8>();
+        let window = Self { guest_base, size, host_base };
+        assert_eq!(host_base as usize & PAGE_SIZE_ALIGN_MASK as usize, 0);
+        Ok(window)
+    }
+
+    /// The starting address must itself be mapped, including for empty spans.
+    /// Using u64 also permits the final byte at guest address 0xffff_ffff.
+    fn offset(&self, address: VAddr, count: GuestUSize) -> Option<usize> {
+        let offset = (address as u64).checked_sub(self.guest_base as u64)?;
+        if offset >= self.size as u64 || count as u64 > self.size as u64 - offset {
+            return None;
+        }
+        Some(offset as usize)
+    }
+
+    fn guest_address(&self, pointer: *const std::ffi::c_void) -> Option<VAddr> {
+        let offset = (pointer as usize).checked_sub(self.host_base as usize)?;
+        if offset >= self.size {
+            return None;
+        }
+        u32::try_from(self.guest_base as u64 + offset as u64).ok()
+    }
+}
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        unsafe { host::free_guest_memory(self.host_base.cast(), self.size).unwrap() };
+    }
+}
+
+pub(super) struct Backing {
+    low: Window,
+    stack: Window,
+}
+
+impl Backing {
+    pub(super) fn new() -> std::io::Result<Self> {
+        // If the second allocation fails, the first Window is dropped.
+        let low = Window::new(0, LOW_SIZE as usize)?;
+        let stack = Window::new(
+            Mem::MAIN_THREAD_STACK_LOW_END,
+            Mem::MAIN_THREAD_STACK_SIZE as usize,
+        )?;
+        Ok(Self { low, stack })
+    }
+
+    fn pointer(&self, address: VAddr, count: GuestUSize) -> Option<*mut u8> {
+        for window in [&self.low, &self.stack] {
+            if let Some(offset) = window.offset(address, count) {
+                return Some(unsafe { window.host_base.add(offset) });
+            }
+        }
+        None
+    }
+
+    pub(super) fn contains(&self, address: VAddr, count: GuestUSize) -> bool {
+        self.pointer(address, count).is_some()
+    }
+
+    pub(super) fn bytes(&self, address: VAddr, count: GuestUSize) -> Option<&[u8]> {
+        let pointer = self.pointer(address, count)?;
+        Some(unsafe { std::slice::from_raw_parts(pointer, count as usize) })
+    }
+
+    pub(super) fn bytes_mut(
+        &mut self,
+        address: VAddr,
+        count: GuestUSize,
+    ) -> Option<&mut [u8]> {
+        let pointer = self.pointer(address, count)?;
+        Some(unsafe { std::slice::from_raw_parts_mut(pointer, count as usize) })
+    }
+
+    /// Checks both spans before writing, including copies between windows.
+    pub(super) fn copy(&mut self, dest: VAddr, src: VAddr, count: GuestUSize) {
+        let source = self.pointer(src, count).expect("unmapped compact memmove source");
+        let destination = self.pointer(dest, count).expect("unmapped compact memmove destination");
+        // Raw pointers are derived from the owning allocations, not from
+        // overlapping shared/mutable slices. ptr::copy permits overlap.
+        unsafe { std::ptr::copy(source, destination, count as usize) };
+    }
+
+    pub(super) fn guest_address(&self, pointer: *const std::ffi::c_void) -> Option<VAddr> {
+        self.low.guest_address(pointer).or_else(|| self.stack.guest_address(pointer))
+    }
+}
