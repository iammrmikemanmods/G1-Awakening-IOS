--- a/platform/ios/scripts/build-rust.sh
+++ b/platform/ios/scripts/build-rust.sh
@@ -13,6 +13,23 @@
     dynarmic|interpreter) ;;
     *)
         echo "TOUCHHLE_CPU_BACKEND must be dynarmic or interpreter" >&2
+        exit 2
+        ;;
+esac
+
+# Optional guest layout. Keep the historical flat mapping unless explicitly
+# selected; compact windows cannot supply Dynarmic's flat direct-memory base.
+TOUCHHLE_GUEST_MEMORY=${TOUCHHLE_GUEST_MEMORY:-flat}
+case "$TOUCHHLE_GUEST_MEMORY" in
+    flat) ;;
+    compact)
+        if [ "$TOUCHHLE_CPU_BACKEND" != interpreter ]; then
+            echo "TOUCHHLE_GUEST_MEMORY=compact requires TOUCHHLE_CPU_BACKEND=interpreter" >&2
+            exit 2
+        fi
+        ;;
+    *)
+        echo "TOUCHHLE_GUEST_MEMORY must be flat or compact" >&2
         exit 2
         ;;
 esac
@@ -144,10 +161,14 @@
 fi
 
 if [ "$TOUCHHLE_CPU_BACKEND" = interpreter ]; then
-    set -- "$@" --no-default-features --features cpu-interpreter
-fi
-
-echo "Building $CORE_LIB_NAME for $TARGET with CPU backend: $TOUCHHLE_CPU_BACKEND"
+    TOUCHHLE_ENTRY_FEATURES=cpu-interpreter
+    if [ "$TOUCHHLE_GUEST_MEMORY" = compact ]; then
+        TOUCHHLE_ENTRY_FEATURES="$TOUCHHLE_ENTRY_FEATURES,compact-memory"
+    fi
+    set -- "$@" --no-default-features --features "$TOUCHHLE_ENTRY_FEATURES"
+fi
+
+echo "Building $CORE_LIB_NAME for $TARGET with CPU backend: $TOUCHHLE_CPU_BACKEND; guest memory: $TOUCHHLE_GUEST_MEMORY"
 cargo "$@"
 
 if [ "$CONFIGURATION" = Release ]; then
--- a/platform/ios/rust-entry/Cargo.toml
+++ b/platform/ios/rust-entry/Cargo.toml
@@ -15,6 +15,8 @@
 default = ["cpu-dynarmic"]
 cpu-dynarmic = ["touchHLE/cpu-dynarmic"]
 cpu-interpreter = ["touchHLE/cpu-interpreter"]
+# Forward the layout and select the entry capability consistently with its CPU.
+compact-memory = ["cpu-interpreter", "touchHLE/compact-memory"]
 
 [dependencies]
 touchHLE = { path = "../../..", default-features = false, features = ["dynamic-sdl"] }
