+        // Optional G1 diagnostic input: enqueue ordinary SDL mouse events so
+        // the existing SDL -> UIKit touch path remains the code under test.
+        // Format: milliseconds_since_first_poll down|up host_x host_y.
+        if let Some(path) = env::var_os("G1_INPUT_SCRIPT") {
+            use std::sync::{Mutex, OnceLock};
+            type ProbeEvent = (u64, bool, i32, i32);
+            struct ProbeInput {
+                start: Instant,
+                pending: VecDeque<ProbeEvent>,
+                parsed_lines: usize,
+                last_ms: u64,
+            }
+            static INPUT: OnceLock<Mutex<ProbeInput>> = OnceLock::new();
+            let input = INPUT.get_or_init(|| Mutex::new(ProbeInput {
+                start: now, pending: VecDeque::new(), parsed_lines: 0, last_ms: 0,
+            }));
+            let mut input = input.lock().unwrap();
+            let elapsed_ms = input.start.elapsed().as_millis() as u64;
+            // Scripts may grow while the probe runs. Replace the file atomically
+            // when appending; previously consumed lines must remain unchanged.
+            let text = std::fs::read_to_string(&path).unwrap();
+            let lines: Vec<_> = text.lines()
+                .filter(|line| !line.trim().is_empty() && !line.starts_with('#')).collect();
+            assert!(lines.len() >= input.parsed_lines, "G1 input script cannot shrink");
+            for line in lines.iter().skip(input.parsed_lines) {
+                let parts: Vec<_> = line.split_whitespace().collect();
+                assert_eq!(parts.len(), 4, "invalid G1 input script line");
+                let milliseconds: u64 = if let Some(delay) = parts[0].strip_prefix('+') {
+                    elapsed_ms + delay.parse::<u64>().unwrap()
+                } else {
+                    parts[0].parse().unwrap()
+                };
+                assert!(milliseconds >= input.last_ms, "G1 inputs must be sorted");
+                input.last_ms = milliseconds;
+                let down = match parts[1] {
+                    "down" => true,
+                    "up" => false,
+                    _ => panic!("invalid G1 input action"),
+                };
+                input.pending.push_back((milliseconds, down, parts[2].parse().unwrap(), parts[3].parse().unwrap()));
+            }
+            if lines.len() != input.parsed_lines {
+                echo!("G1_INPUT: loaded {} new SDL events from {:?} at {}ms",
